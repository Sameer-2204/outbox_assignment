generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  googleId      String   @unique
  email         String   @unique
  name          String
  avatar        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  slackConnections SlackConnection[]
  emails           Email[]

  @@map("users")
}

model Email {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  sender        String
  recipient     String
  subject       String
  body          String
  status        EmailStatus @default(SCHEDULED)
  scheduledAt   DateTime
  sentAt        DateTime?
  errorMessage  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userId, status])
  @@index([sender, scheduledAt])
  @@map("emails")
}

enum EmailStatus {
  SCHEDULED
  SENT
  FAILED
}

model SlackConnection {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  webhookUrl  String
  channelName String?
  teamName    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId])
  @@map("slack_connections")
}
