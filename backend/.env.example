# ── Infrastructure ──────────────────────────────────
DATABASE_URL="postgresql://outbox:outbox_pass@localhost:5432/outbox_db"
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Elasticsearch ───────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200

# ── Google OAuth ────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# ── Session / JWT ───────────────────────────────────
SESSION_SECRET=change-me-to-a-random-string
JWT_SECRET=change-me-to-a-random-jwt-secret

# ── Ethereal SMTP (sender accounts) ────────────────
# Comma-separated list of sender accounts.
# Format per sender: email:password
# Create accounts at https://ethereal.email/create
ETHEREAL_ACCOUNTS=sender1@ethereal.email:password1,sender2@ethereal.email:password2

# ── Worker ──────────────────────────────────────────
WORKER_CONCURRENCY=3
MIN_SEND_DELAY_MS=2000

# ── Rate Limiting ───────────────────────────────────
MAX_EMAILS_PER_HOUR_PER_SENDER=50

# ── Slack OAuth ─────────────────────────────────────
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback

# ── Server ──────────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:3000
